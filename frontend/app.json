{
  "expo": {
    "name": "OAaGaya",
    "slug": "customer-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/oAaGaya.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/oAaGaya-launcher-safe.png"
      },
      "predictiveBackGestureEnabled": false,
      "cleartextTrafficPermitted": true,
      "package": "com.vengeace.customermanagement"
    },
    "web": {
      "favicon": "./assets/oAaGaya-launcher-safe.png"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/oAaGaya-launcher-safe.png",
          "color": "#FFFFFF"
        }
      ],

      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can set a shop photo for your profile."
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/oAaGaya.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3f51a10f-b27e-45f1-8e75-3003ca298f8f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3f51a10f-b27e-45f1-8e75-3003ca298f8f"
    }
  }
}
